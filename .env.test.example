# Live-money / E2E test environment.
# Copy to .env.test and fill in the values printed by:
#   supabase status --workdir supabase-test
#
# .env.test is gitignored. .env.test.example is the committed shape.

TEST_SUPABASE_URL=http://127.0.0.1:64361
TEST_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
TEST_SUPABASE_SECRET_KEY=
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:64362/postgres
TEST_NEXT_PORT=3100
